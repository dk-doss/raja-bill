{
  "name": "raja-store",
  "version": "1.0.0",
  "description": "RAJA STORE - Customer Ordering & Store Management System",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"blue,green\" \"npm run server\" \"npm run client\""
  },
  "keywords": [
    "raja-store",
    "retail",
    "ordering",
    "store-management"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "concurrently": "^9.2.4",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "multer": "^2.4.0",
    "uuid": "^14.0.2"
  }
}
